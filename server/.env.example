# MongoDB connection string (Atlas or local). Required always.
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/messkhata?retryWrites=true&w=majority

# JWT signing secret. Required always. Must be >= 32 chars in production.
JWT_SECRET=your_jwt_secret_here

# Optional. Port the server listens on (defaults to 5000).
PORT=5000

# Optional. Set to 'false' to disable the in-process cron when an external
# scheduler hits POST /api/internal/run-reminders instead. Defaults to 'true'.
ENABLE_IN_PROCESS_CRON=true

# Required in production. Comma-separated list of allowed browser origins
# (your Vercel frontend), e.g. https://messkhata.vercel.app.
CLIENT_ORIGIN=http://localhost:5173

# Required in production. Shared secret for the x-cron-secret header on
# POST /api/internal/run-reminders. When set, that route is registered.
CRON_SECRET=
